[Unit]
Description=Razor reconciliation and operations worker
Wants=network-online.target
After=network-online.target razor-web.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=razor
Group=razor
WorkingDirectory=/opt/razor/current
Environment=PATH=/opt/razor/runtime/node-v24.22.3-linux-arm64/bin:/usr/bin:/bin
ExecStart=/opt/razor/runtime/node-v24.22.3-linux-arm64/bin/node --max-old-space-size=384 --env-file=/etc/razor/razor.env --import tsx scripts/worker.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
MemoryHigh=512M
MemoryMax=768M
CPUQuota=50%
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/razor /var/cache/razor
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
