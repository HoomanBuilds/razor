{
  "name": "float",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "node scripts/next-with-memory-guard.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/next-with-memory-guard.mjs build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=1024 tsc --noEmit",
    "test": "node --max-old-space-size=1024 --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "worker": "node --max-old-space-size=512 --env-file-if-exists=.env.local --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.26",
    "@hot-labs/near-connect": "^0.12.0",
    "@nearai/inference-sdk": "^0.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@privy-io/react-auth": "^3.51.3",
    "@scure/base": "^2.4.0",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "near-api-js": "^7.2.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
